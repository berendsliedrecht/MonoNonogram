<?xml version="1.0" encoding="utf-8"?>
<!-- Nonogram glyph: outlined 4x4 grid with a few filled cells, e-ink friendly. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer frame -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M34,34 H74 V74 H34 Z" />

    <!-- inner grid lines -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:pathData="M44,34 V74 M54,34 V74 M64,34 V74 M34,44 H74 M34,54 H74 M34,64 H74" />

    <!-- filled cells -->
    <path
        android:fillColor="#000000"
        android:pathData="M44,34 H54 V44 H44 Z M54,44 H64 V54 H54 Z M34,54 H44 V64 H34 Z M64,54 H74 V64 H64 Z M44,64 H54 V74 H44 Z" />
</vector>
